<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hospital.clinic.mapper.PrescriptionItemMapper">

    <resultMap id="BaseResultMap" type="com.hospital.clinic.entity.PrescriptionItem">
        <id column="id" property="id"/>
        <result column="prescription_id" property="prescriptionId"/>
        <result column="drug_id" property="drugId"/>
        <result column="drug_name" property="drugName"/>
        <result column="specification" property="specification"/>
        <result column="dosage" property="dosage"/>
        <result column="usage_method" property="usageMethod"/>
        <result column="frequency" property="frequency"/>
        <result column="days" property="days"/>
        <result column="quantity" property="quantity"/>
        <result column="unit" property="unit"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <insert id="insertBatch">
        INSERT INTO prescription_item (prescription_id, drug_id, drug_name,
                                       specification, dosage, usage_method,
                                       frequency, days, quantity, unit, remark)
        VALUES
        <foreach collection="items" item="item" separator=",">
            (#{item.prescriptionId}, #{item.drugId}, #{item.drugName},
             #{item.specification}, #{item.dosage}, #{item.usageMethod},
             #{item.frequency}, #{item.days}, #{item.quantity}, #{item.unit},
             #{item.remark})
        </foreach>
    </insert>

    <select id="selectByPrescriptionId" resultMap="BaseResultMap">
        SELECT * FROM prescription_item
        WHERE prescription_id = #{prescriptionId}
    </select>

</mapper>
