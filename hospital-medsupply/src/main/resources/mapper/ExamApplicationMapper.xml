<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hospital.medsupply.mapper.ExamApplicationMapper">

    <resultMap id="BaseResultMap" type="com.hospital.medsupply.entity.ExamApplication">
        <id column="id" property="id"/>
        <result column="application_no" property="applicationNo"/>
        <result column="medical_record_id" property="medicalRecordId"/>
        <result column="patient_id" property="patientId"/>
        <result column="doctor_id" property="doctorId"/>
        <result column="exam_item_id" property="examItemId"/>
        <result column="exam_item_name" property="examItemName"/>
        <result column="item_type" property="itemType"/>
        <result column="apply_remark" property="applyRemark"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.hospital.medsupply.entity.ExamApplication"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO exam_application (application_no, medical_record_id, patient_id,
                                      doctor_id, exam_item_id, exam_item_name,
                                      item_type, apply_remark, status, create_time)
        VALUES (#{applicationNo}, #{medicalRecordId}, #{patientId},
                #{doctorId}, #{examItemId}, #{examItemName},
                #{itemType}, #{applyRemark}, #{status}, NOW())
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM exam_application WHERE id = #{id}
    </select>

    <select id="selectByNo" resultMap="BaseResultMap">
        SELECT * FROM exam_application WHERE application_no = #{applicationNo}
    </select>

    <select id="selectByPatientId" resultMap="BaseResultMap">
        SELECT * FROM exam_application
        WHERE patient_id = #{patientId}
        ORDER BY create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="countByPatientId" resultType="long">
        SELECT COUNT(*) FROM exam_application
        WHERE patient_id = #{patientId}
    </select>

    <update id="updateStatus">
        UPDATE exam_application
        SET status = #{status}
        WHERE id = #{id}
    </update>

</mapper>
