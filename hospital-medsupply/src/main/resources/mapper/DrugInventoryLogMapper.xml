<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hospital.medsupply.mapper.DrugInventoryLogMapper">

    <resultMap id="BaseResultMap" type="com.hospital.medsupply.entity.DrugInventoryLog">
        <id column="id" property="id"/>
        <result column="drug_id" property="drugId"/>
        <result column="change_type" property="changeType"/>
        <result column="change_quantity" property="changeQuantity"/>
        <result column="before_stock" property="beforeStock"/>
        <result column="after_stock" property="afterStock"/>
        <result column="related_order_id" property="relatedOrderId"/>
        <result column="operator_id" property="operatorId"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.hospital.medsupply.entity.DrugInventoryLog"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO drug_inventory_log (drug_id, change_type, change_quantity,
                                        before_stock, after_stock, related_order_id,
                                        operator_id, remark, create_time)
        VALUES (#{drugId}, #{changeType}, #{changeQuantity},
                #{beforeStock}, #{afterStock}, #{relatedOrderId},
                #{operatorId}, #{remark}, SYSDATE)
    </insert>

    <select id="selectByDrugId" resultMap="BaseResultMap">
        SELECT * FROM drug_inventory_log
        WHERE drug_id = #{drugId}
        ORDER BY create_time DESC
        OFFSET #{offset} ROWS FETCH NEXT #{limit} ROWS ONLY
    </select>

    <select id="countByDrugId" resultType="long">
        SELECT COUNT(*) FROM drug_inventory_log
        WHERE drug_id = #{drugId}
    </select>

</mapper>
