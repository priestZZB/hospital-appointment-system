<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hospital.medsupply.mapper.ExamReportMapper">

    <resultMap id="BaseResultMap" type="com.hospital.medsupply.entity.ExamReport">
        <id column="id" property="id"/>
        <result column="application_id" property="applicationId"/>
        <result column="patient_id" property="patientId"/>
        <result column="report_desc" property="reportDesc"/>
        <result column="report_result" property="reportResult"/>
        <result column="attachment_url" property="attachmentUrl"/>
        <result column="attachment_name" property="attachmentName"/>
        <result column="operator_id" property="operatorId"/>
        <result column="status" property="status"/>
        <result column="complete_time" property="completeTime"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.hospital.medsupply.entity.ExamReport"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO exam_report (application_id, patient_id, report_desc,
                                 report_result, attachment_url, attachment_name,
                                 operator_id, status, complete_time, create_time)
        VALUES (#{applicationId}, #{patientId}, #{reportDesc},
                #{reportResult}, #{attachmentUrl}, #{attachmentName},
                #{operatorId}, #{status}, #{completeTime}, NOW())
    </insert>

    <select id="selectByApplicationId" resultMap="BaseResultMap">
        SELECT * FROM exam_report WHERE application_id = #{applicationId}
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM exam_report WHERE id = #{id}
    </select>

    <select id="selectByPatientId" resultMap="BaseResultMap">
        SELECT * FROM exam_report
        WHERE patient_id = #{patientId}
        ORDER BY create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="countByPatientId" resultType="long">
        SELECT COUNT(*) FROM exam_report
        WHERE patient_id = #{patientId}
    </select>

    <update id="updateStatus">
        UPDATE exam_report
        SET status = #{status},
            complete_time = #{completeTime}
        WHERE id = #{id}
    </update>

</mapper>
