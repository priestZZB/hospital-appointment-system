diff --git a/hospital-clinic/src/main/java/com/hospital/clinic/mapper/AppointmentMapper.java b/hospital-clinic/src/main/java/com/hospital/clinic/mapper/AppointmentMapper.java
index aab5158..c0b4b04 100644
--- a/hospital-clinic/src/main/java/com/hospital/clinic/mapper/AppointmentMapper.java
+++ b/hospital-clinic/src/main/java/com/hospital/clinic/mapper/AppointmentMapper.java
@@ -5,6 +5,7 @@ import com.hospital.clinic.vo.AppointmentVO;
 import org.apache.ibatis.annotations.Mapper;
 import org.apache.ibatis.annotations.Param;
 
+import java.time.LocalDate;
 import java.util.List;
 
 /**
@@ -48,4 +49,26 @@ public interface AppointmentMapper {
     /** 排班级联取消：将某排班下所有待支付预约置为已取消 */
     int cancelPendingPayByScheduleId(@Param("scheduleId") Long scheduleId,
                                      @Param("cancelReason") String cancelReason);
+
+    /** 根据排班 ID 查询所有预约 */
+    List<Appointment> selectByScheduleId(@Param("scheduleId") Long scheduleId);
+
+    /** 更新 visit_status（带预期状态检查） */
+    int updateVisitStatus(@Param("id") Long id,
+                          @Param("visitStatus") String visitStatus,
+                          @Param("expectedStatus") String expectedStatus);
+
+    // ==================== BI 统计 ====================
+
+    /** 按日期统计预约数 */
+    Long countByDate(@Param("date") LocalDate date);
+
+    /** 按日期统计完成就诊数 */
+    Long countCompletedByDate(@Param("date") LocalDate date);
+
+    /** 按日期统计收入（PAID） */
+    java.math.BigDecimal sumRevenueByDate(@Param("date") LocalDate date);
+
+    /** 按科室分组统计当日预约数 */
+    List<java.util.Map<String, Object>> countGroupByDept(@Param("date") LocalDate date);
 }
diff --git a/hospital-clinic/src/main/resources/mapper/AppointmentMapper.xml b/hospital-clinic/src/main/resources/mapper/AppointmentMapper.xml
index ba65b2e..023b41a 100644
--- a/hospital-clinic/src/main/resources/mapper/AppointmentMapper.xml
+++ b/hospital-clinic/src/main/resources/mapper/AppointmentMapper.xml
@@ -156,4 +156,49 @@
           AND a.order_status = 'PENDING_PAY'
     </update>
 
+    <select id="selectByScheduleId" resultMap="BaseResultMap">
+        SELECT id, appointment_no, patient_id, slot_id, schedule_id,
+               doctor_id, department_id, appointment_date, period, slot_seq,
+               register_fee, order_status, visit_status, is_revisit,
+               cancel_time, cancel_reason, create_time, update_time
+        FROM appointment
+        WHERE schedule_id = #{scheduleId}
+    </select>
+
+    <update id="updateVisitStatus">
+        UPDATE appointment SET visit_status = #{visitStatus}, update_time = NOW()
+        WHERE id = #{id}
+        <if test="expectedStatus != null">
+          AND visit_status = #{expectedStatus}
+        </if>
+    </update>
+
+    <!-- ==================== BI 统计 ==================== -->
+
+    <select id="countByDate" resultType="long">
+        SELECT COUNT(*) FROM appointment
+        WHERE appointment_date = #{date}
+    </select>
+
+    <select id="countCompletedByDate" resultType="long">
+        SELECT COUNT(*) FROM appointment
+        WHERE appointment_date = #{date}
+          AND visit_status = 'COMPLETED'
+    </select>
+
+    <select id="sumRevenueByDate" resultType="java.math.BigDecimal">
+        SELECT COALESCE(SUM(register_fee), 0) FROM appointment
+        WHERE appointment_date = #{date}
+          AND order_status IN ('PAID', 'REFUNDED', 'COMPLETED')
+    </select>
+
+    <select id="countGroupByDept" resultType="java.util.HashMap">
+        SELECT dep.dept_name AS deptName, COUNT(*) AS count
+        FROM appointment a
+        LEFT JOIN department dep ON a.department_id = dep.id
+        WHERE a.appointment_date = #{date}
+        GROUP BY a.department_id, dep.dept_name
+        ORDER BY count DESC
+    </select>
+
 </mapper>
